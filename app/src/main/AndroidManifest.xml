<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Opening a link from the Markdown reader. Package visibility only bites at
         targetSdk 30+, but declaring it now means raising targetSdk later can't
         silently break the reader's links. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".KodelabApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kodelab"
        android:hardwareAccelerated="true">

        <!-- Multi-window (REQ 7): each window is its own document task. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Kodelab.Splash"
            android:exported="true"
            android:documentLaunchMode="intoExisting"
            android:resizeableActivity="true"
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Publishes the Alpine sandbox home in the system file picker's drawer,
             so a repo cloned in the terminal is reachable from any "Open from…".
             MANAGE_DOCUMENTS is signature-level: only the system documents UI can
             bind; every other app gets access one granted uri at a time. -->
        <provider
            android:name=".workspace.KodelabDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Shared, device-wide terminal session host (REQ 5 / REQ 8). -->
        <service
            android:name=".terminal.TerminalSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps developer shell sessions (builds, language servers) alive while the app is backgrounded." />
        </service>
    </application>
</manifest>
